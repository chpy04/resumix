# Template for prod/.env, production's secrets. Copy it beside this file
# and fill it in:
#
#     cp .env.example .env && chmod 600 .env
#
# `docker compose` reads `.env` from this folder by itself, which is why the
# file has that name (D-053). It is gitignored, and .dockerignore keeps the
# whole folder out of every image. This template carries no values and is
# committed.
#
# Generate each random string separately, in hex:
#
#     openssl rand -hex 32
#
# Not base64: its `/` breaks the DATABASE_URL built from POSTGRES_PASSWORD.
# Compose expands `$` in unquoted values, so single-quote one that has it.

# Postgres password for the production database. Used to build the app's
# DATABASE_URL inside docker-compose.yml — you never write that URL out.
# It is spliced in unescaped, so it must be URL-safe; hex is. Postgres takes
# it only when the volume is first created, so changing it here later does
# not change the database's (docs/DEPLOYMENT.md, Troubleshooting).
POSTGRES_PASSWORD=

# The login gate (RESUMIX_AUTH_MODE=password). APP_PASSWORD is what you type;
# AUTH_SECRET signs the session token. They must be different values.
APP_PASSWORD=
AUTH_SECRET=

# Shared secret the app presents to the latex sidecar. Required in prod —
# the sidecar refuses unauthenticated /compile calls when this is set, and
# logs a warning when it is not (services/latex/server.js).
LATEX_SERVICE_TOKEN=

# Which user the password gate logs in as, and who owns the tokens
# ./mint-token creates. The first deploy's seed creates exactly this user
# (lib/session.ts, OWNER_EMAIL).
OWNER_EMAIL=

# Display name for that user. Set it: compose passes a blank one through as
# an empty string, which the seed stores instead of its default.
SEED_USER_NAME=

# The https:// address you open Resumix at, with no path. Nothing in the
# stack reads it; ./mint-token builds the agent's MCP URL from it.
PUBLIC_URL=

# ---------------------------------------------------------------------------
# Optional. Everything below can be left empty; the feature degrades rather
# than the deploy failing.
# ---------------------------------------------------------------------------

# Filename prefix for downloaded PDFs (lib/filename.ts). Defaults to Chris_Pyle.
PDF_NAME_PREFIX=

# Powers the in-app "Give feedback" button, which files a GitHub issue
# (lib/feedback/github.ts). Without both, POST /api/feedback returns 503 and
# nothing else is affected. GITHUB_REPO is "owner/repo".
GITHUB_TOKEN=
GITHUB_REPO=
