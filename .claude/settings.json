{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run smoke)",
      "Bash(npm run test:e2e)",
      "Bash(npm run db:migrate)",
      "Bash(npm run db:seed:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx playwright test:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up -d db latex)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",

      "Read(~/.resumix/**)",
      "Edit(~/.resumix/**)",
      "Write(~/.resumix/**)",

      "Bash(docker compose -f docker-compose.prod.yml:*)",
      "Bash(docker compose --env-file:*)",

      "Read(./prod/.env)",
      "Edit(./prod/.env)",
      "Write(./prod/.env)",
      "Read(./prod/backups/**)",
      "Bash(prod/mint-token:*)",
      "Bash(./prod/mint-token:*)",
      "Bash(./mint-token:*)",
      "Bash(bash prod/mint-token:*)",
      "Bash(docker compose -f prod/docker-compose.yml:*)",
      "Bash(docker compose --project-directory prod:*)",

      "Read(./agent/.env)",
      "Read(./agent/.browser-profile/**)",
      "Edit(./agent/career-ops/**)",
      "Write(./agent/career-ops/**)",
      "Read(./agent/career-ops-data/**)",
      "Edit(./agent/career-ops-data/**)",
      "Write(./agent/career-ops-data/**)",

      "Bash(agent/claude.sh:*)",
      "Bash(./agent/claude.sh:*)",
      "Bash(bash agent/claude.sh:*)",
      "Bash(sh agent/claude.sh:*)",
      "Bash(agent/connect.sh:*)",
      "Bash(./agent/connect.sh:*)",
      "Bash(bash agent/connect.sh:*)",
      "Bash(sh agent/connect.sh:*)"
    ]
  }
}
