# Postgres. Local dev points at the docker-compose `db` service.
DATABASE_URL=postgres://resumix:resumix@localhost:5433/resumix

# LaTeX compile sidecar (docker-compose `latex` service).
LATEX_SERVICE_URL=http://localhost:8080
# Shared secret for the sidecar. Optional locally (it is only on a private
# docker network); REQUIRED for any real deployment, because the service has no
# other auth and LaTeX can read files on the box. Set the same value on both.
LATEX_SERVICE_TOKEN=

# Which authentication scheme is in force: dev | password | supabase.
# Unset means `dev` outside production and `password` in production.
#
#   dev       no login screen at all — the app signs in as the first user in
#             the `users` table, i.e. whoever `npm run db:seed` created. This
#             is the normal local-development setting; leave it unset.
#   password  the shared-password gate below, for a real deployment.
#   supabase  Supabase OAuth — NOT IMPLEMENTED yet (lib/auth-supabase.ts).
#             Fails closed: every request is rejected.
RESUMIX_AUTH_MODE=

# The shared-password gate. Only used when RESUMIX_AUTH_MODE=password.
# Set to a long random string.
APP_PASSWORD=change-me-to-something-long
# Secret used to mint the browser token. Any long random string.
AUTH_SECRET=change-me-too
# Which account the shared password logs in as. Optional while there is only
# one user (it is then unambiguous); required once there are several.
OWNER_EMAIL=

# Who `npm run db:seed` creates. The default matches the address in the
# reference resume's header, so a default seed is self-consistent.
SEED_USER_EMAIL=
SEED_USER_NAME=

# Prefix for downloaded PDFs: <PDF_NAME_PREFIX>_<Company>_Resume.pdf
PDF_NAME_PREFIX=Chris_Pyle

# In-app feedback ("Give feedback" button) -> GitHub issue.
# Token needs write access to issues and contents on the repo below; a classic
# PAT with `repo`, or a fine-grained PAT with Issues:write + Contents:write.
# Unset means the widget's submit fails with 503 — it never files silently.
GITHUB_TOKEN=
GITHUB_REPO=chpy04/resumix
# Orphan branch screenshots are committed to. Optional; this is the default.
FEEDBACK_ASSETS_BRANCH=feedback-assets
