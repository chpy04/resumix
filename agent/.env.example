# The applying Claude's environment (D-038). Copy to agent/.env, which is
# gitignored, and fill in all three. Claude Code reads no .env file itself, so
# start every session with ./claude.sh: it loads this file and refuses to start
# while any value is empty. agent/.mcp.json expands the first two.

# Production's MCP endpoint, the /api/mcp path and nothing else, such as
# https://<your-production-host>/api/mcp. Never the dev server: this Claude
# works on real applications.
RESUMIX_MCP_URL=

# An rmx_ token, minted by Chris against production with `npm run token:create`.
# It authenticates /api/mcp/** and nothing else.
RESUMIX_MCP_TOKEN=

# Absolute path to career-ops' personal files: cv.md, config/profile.yml,
# modes/_custom.md, data/, and the rest of what its AGENTS.md calls the user
# layer. Keeping them out of the submodule leaves career-ops/ an untouched
# checkout of its pinned tag. Suggested: <checkout>/agent/career-ops-data,
# which is gitignored.
CAREER_OPS_DATA_DIR=
