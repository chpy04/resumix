{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": ["**/resumix/CLAUDE.md", "**/resumix/.claude/rules/**"],
  "permissions": {
    "deny": [
      "Read(./.env)",

      "Edit(./career-ops/**)",
      "Write(./career-ops/**)",

      "Bash(npm run verify)",
      "Bash(npm run verify:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run dev)",
      "Bash(npm run dev:*)",
      "Bash(npm run deploy:prod)",
      "Bash(npm run deploy:prod:*)",

      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  }
}
