# Template for ~/.resumix/prod.env — the production instance's secrets.
#
# `npm run deploy:prod` copies this there (mode 600) on first run and stops
# so you can fill it in. The real file lives outside the repo on purpose:
# nothing in the checkout can load it, and it cannot be committed by
# accident. This template carries no values and is committed.
#
# Generate each random string separately:
#
#     openssl rand -base64 32

# Postgres password for the production database. Used to build the app's
# DATABASE_URL inside docker-compose.prod.yml — you never write that URL out.
POSTGRES_PASSWORD=

# The login gate (RESUMIX_AUTH_MODE=password). APP_PASSWORD is what you type;
# AUTH_SECRET signs the session token. They must be different values.
APP_PASSWORD=
AUTH_SECRET=

# Shared secret the app presents to the latex sidecar. Required in prod —
# the sidecar refuses unauthenticated /compile calls when this is set, and
# logs a warning when it is not (services/latex/server.js).
LATEX_SERVICE_TOKEN=

# Which user the password gate logs in as. Must match a row in `users`; the
# first deploy's seed creates exactly this one (lib/session.ts, OWNER_EMAIL).
OWNER_EMAIL=

# Display name for that user. Optional — the seed has a default.
SEED_USER_NAME=

# ---------------------------------------------------------------------------
# Optional. Everything below can be left empty; the feature degrades rather
# than the deploy failing.
# ---------------------------------------------------------------------------

# Filename prefix for downloaded PDFs (lib/filename.ts). Defaults to Chris_Pyle.
PDF_NAME_PREFIX=

# Powers the in-app "Give feedback" button, which files a GitHub issue
# (lib/feedback/github.ts). Without both, POST /api/feedback returns 503 and
# nothing else is affected. GITHUB_REPO is "owner/repo".
GITHUB_TOKEN=
GITHUB_REPO=
